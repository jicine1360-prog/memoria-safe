<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Memoria" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/safe_green</item>
        <item name="colorPrimaryDark">@color/safe_green_dark</item>
        <item name="colorAccent">@color/emergency_red</item>
        <item name="colorOnError">@color/text_primary</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="colorSurface">@color/dark_background</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/dark_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/dark_surface</item>
        <item name="android:windowBackground">@color/dark_background</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:statusBarColor">@color/dark_surface</item>
        <item name="android:navigationBarColor">@color/dark_surface</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>

    <style name="Theme.Memoria.SOS" parent="Theme.Memoria">
        <item name="android:windowBackground">@color/emergency_red</item>
        <item name="android:statusBarColor">@color/emergency_red</item>
        <item name="android:navigationBarColor">@color/emergency_red_dark</item>
    </style>

    <style name="Widget.Memoria.SOSButton" parent="Widget.Material3.Button.ElevatedButton">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_width">150dp</item>
        <item name="android:layout_height">150dp</item>
        <item name="android:minWidth">150dp</item>
        <item name="android:minHeight">150dp</item>
        <item name="cornerRadius">75dp</item>
        <item name="cornerSize">75dp</item>
    </style>

    <style name="Widget.Memoria.StatusIndicator" parent="Widget.Material3.Button.TextButton">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">8dp</item>
        <item name="android:minWidth">120dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Widget.Memoria.WaveformView" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">120dp</item>
    </style>

    <style name="Widget.Memoria.QuickContact" parent="Widget.Material3.Button.TextButton">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">12dp</item>
        <item name="android:minWidth">200dp</item>
        <item name="android:minHeight">64dp</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="Widget.Memoria.EventLogItem" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">4dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">80dp</item>
    </style>
</resources>
